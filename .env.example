# Payload CMS / Postgres (Supabase)
DATABASE_URI=
PAYLOAD_DB_SCHEMA=payload
PAYLOAD_DB_PUSH=false
PAYLOAD_SECRET=

# Supabase Storage (Media uploads — src/payload/storage/supabase.ts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
# Public anon key, used client-side only to satisfy Supabase's API-gateway apikey
# requirement when PUTting to a signed upload URL. Safe to expose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel Cron (src/app/(frontend)/api/keepalive/route.ts) — optional, locks the endpoint
# down to the Vercel Cron invoker when set.
CRON_SECRET=

# EmailJS (existing contact-form integration)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Behold (Instagram feed widget)
BEHOLD_FEED_ID=
